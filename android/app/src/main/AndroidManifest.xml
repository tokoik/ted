<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.ted_openxr">

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.opengles.aep"
        android:required="true" />

    <!-- パススルー映像の表示 (XR_FB_passthrough) -->
    <uses-feature
        android:name="com.oculus.feature.PASSTHROUGH"
        android:required="true" />

    <!-- ハンドトラッキング (XR_EXT_hand_tracking) -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <!-- パススルーカメラの画像の取得 (Passthrough Camera API, Horizon OS v74 以降) -->
    <uses-feature
        android:name="android.hardware.camera2.any"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />

    <!-- 中継サーバ / 指示者 PC との UDP 通信 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:hasCode="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="TED OpenXR Native"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <meta-data
            android:name="org.khronos.openxr.OpenXRRuntimeBroker"
            android:value="true" />
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest3|quest3s" />
        <meta-data
            android:name="com.oculus.handtracking.version"
            android:value="V2.0" />

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:label="TED OpenXR Native"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode">

            <meta-data
                android:name="android.app.lib_name"
                android:value="ted_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
